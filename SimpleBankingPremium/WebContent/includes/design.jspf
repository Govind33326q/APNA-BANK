<%@ page import="com.simplebank.dao.SettingsDAO" %>
<%@ page import="com.simplebank.model.BankSettings" %>
<%
    String ctx = request.getContextPath();
    BankSettings bankSettings = new BankSettings();
    bankSettings.setBankName("Aurora Bank");
    bankSettings.setLogoPath(null);

    try {
        bankSettings = new SettingsDAO().getSettings();
    } catch (Throwable ignored) {
        // Keep public pages visible even before PostgreSQL JDBC driver/database setup.
    }

    String bankName = bankSettings.getBankName() == null ? "Aurora Bank" : bankSettings.getBankName();
    String logoPath = bankSettings.getLogoPath();
    String logoUrl = logoPath == null || logoPath.trim().isEmpty() ? null : ctx + "/" + logoPath;
%>
<style>
    :root {
        --bg: #eef5ff;
        --surface: rgba(255, 255, 255, 0.78);
        --solid: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --line: rgba(148, 163, 184, 0.24);
        --blue: #2563eb;
        --cyan: #06b6d4;
        --green: #16a34a;
        --orange: #f59e0b;
        --red: #dc2626;
        --nav: #ffffffcc;
        --shadow: 0 22px 70px rgba(15, 23, 42, 0.12);
        --soft-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
        --radius: 24px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        background:
            radial-gradient(circle at 10% 10%, rgba(37, 99, 235, 0.16), transparent 28rem),
            radial-gradient(circle at 90% 20%, rgba(6, 182, 212, 0.16), transparent 24rem),
            linear-gradient(135deg, #f8fbff, var(--bg));
        color: var(--text);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    button,
    input,
    select {
        font-family: inherit;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 17px;
        display: grid;
        place-items: center;
        color: #ffffff;
        font-weight: 900;
        background: linear-gradient(135deg, var(--blue), var(--cyan));
        box-shadow: 0 16px 35px rgba(37, 99, 235, 0.25);
        overflow: hidden;
    }

    .brand-logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .brand h2 {
        margin: 0;
        font-size: 20px;
        letter-spacing: -0.03em;
    }

    .brand span {
        display: block;
        color: var(--muted);
        font-size: 12px;
        margin-top: 2px;
    }

    .btn {
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 800;
        transition: 0.22s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--soft-shadow);
    }

    .btn.primary {
        color: #ffffff;
        background: linear-gradient(135deg, var(--blue), var(--cyan));
    }

    .btn.secondary {
        color: #1d4ed8;
        background: rgba(219, 234, 254, 0.9);
    }

    .btn.danger {
        color: #ffffff;
        background: var(--red);
    }

    .layout {
        min-height: 100vh;
        display: flex;
    }

    .sidebar {
        width: 282px;
        position: fixed;
        inset: 18px auto 18px 18px;
        padding: 22px 16px;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: var(--shadow);
        backdrop-filter: blur(22px);
        overflow-y: auto;
    }

    .sidebar .brand {
        margin: 4px 8px 26px;
    }

    .sidebar a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 14px;
        border-radius: 16px;
        margin-bottom: 8px;
        color: #334155;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .sidebar a:hover,
    .sidebar a.active {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(6, 182, 212, 0.12));
        color: #1d4ed8;
        transform: translateX(3px);
    }

    .content {
        margin-left: 318px;
        width: calc(100% - 318px);
        padding: 30px;
    }

    .topbar,
    .panel,
    .stat-card,
    .glass-card {
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: var(--soft-shadow);
        border-radius: var(--radius);
        backdrop-filter: blur(20px);
    }

    .topbar {
        padding: 22px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    h1 {
        margin: 0 0 7px;
        font-size: clamp(28px, 3vw, 42px);
        letter-spacing: -0.05em;
    }

    p {
        color: var(--muted);
        line-height: 1.65;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 18px;
        margin: 20px 0;
    }

    .stat-card {
        padding: 22px;
        position: relative;
        overflow: hidden;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        top: -35px;
        width: 100px;
        height: 100px;
        border-radius: 30px;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.18), rgba(6, 182, 212, 0.16));
        transform: rotate(18deg);
    }

    .stat-card span {
        color: var(--muted);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .stat-card h3 {
        margin: 10px 0 0;
        font-size: 28px;
        letter-spacing: -0.04em;
    }

    .panel {
        padding: 22px;
        margin-bottom: 22px;
        overflow-x: auto;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 22px;
        margin-bottom: 22px;
    }

    .hero-card {
        min-height: 210px;
        padding: 28px;
        border-radius: 32px;
        color: #ffffff;
        background: linear-gradient(135deg, #1d4ed8, #06b6d4);
        box-shadow: 0 28px 70px rgba(37, 99, 235, 0.28);
        overflow: hidden;
        position: relative;
    }

    .hero-card::after {
        content: "";
        position: absolute;
        right: -60px;
        bottom: -80px;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
    }

    .hero-card p,
    .hero-card h1 {
        color: #ffffff;
    }

    .bank-card-3d {
        min-height: 210px;
        padding: 24px;
        border-radius: 30px;
        color: #ffffff;
        background: linear-gradient(135deg, #0f172a, #2563eb, #06b6d4);
        box-shadow: 0 28px 70px rgba(37, 99, 235, 0.25);
        transform: perspective(900px) rotateY(-7deg) rotateX(3deg);
        overflow: hidden;
        position: relative;
    }

    .bank-card-3d::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transform: translateX(-100%);
        animation: cardShine 5s ease-in-out infinite;
    }

    @keyframes cardShine {
        0%, 55% { transform: translateX(-100%); }
        100% { transform: translateX(120%); }
    }

    .chip {
        width: 48px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #fef3c7, #f59e0b);
    }

    .card-number {
        margin: 42px 0 22px;
        font-size: 22px;
        letter-spacing: 0.12em;
        font-weight: 900;
    }

    .card-meta {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #e0f2fe;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
        min-width: 820px;
    }

    th,
    td {
        padding: 14px;
        text-align: left;
    }

    th {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    tbody tr {
        background: rgba(255, 255, 255, 0.86);
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
    }

    tbody td:first-child {
        border-radius: 15px 0 0 15px;
    }

    tbody td:last-child {
        border-radius: 0 15px 15px 0;
    }

    .badge {
        padding: 7px 11px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge.ACTIVE { background: #dcfce7; color: #166534; }
    .badge.PENDING { background: #fef3c7; color: #92400e; }
    .badge.FROZEN { background: #dbeafe; color: #1d4ed8; }
    .badge.CLOSED,
    .badge.REJECTED { background: #fee2e2; color: #991b1b; }

    .form {
        display: grid;
        gap: 12px;
    }

    .form label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #334155;
        font-weight: 900;
    }

    input,
    select {
        width: 100%;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 14px;
        padding: 12px 13px;
        outline: none;
        background: rgba(255, 255, 255, 0.85);
    }

    input:focus,
    select:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .inline-form {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .mini {
        border: none;
        padding: 8px 11px;
        border-radius: 11px;
        color: #ffffff;
        cursor: pointer;
        font-weight: 800;
    }

    .success-btn { background: var(--green); }
    .warning-btn { background: var(--orange); }
    .danger-btn { background: var(--red); }
    .blue-btn { background: var(--blue); }
    .grey-btn { background: #475569; }

    .control-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        min-width: 310px;
    }

    .control-card {
        padding: 12px;
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: rgba(248, 250, 252, 0.85);
        border-radius: 16px;
    }

    .alert {
        padding: 13px 15px;
        border-radius: 16px;
        margin-bottom: 16px;
        font-weight: 800;
    }

    .alert.success { background: #dcfce7; color: #166534; }
    .alert.error { background: #fee2e2; color: #991b1b; }
    .alert.warning { background: #fef3c7; color: #92400e; }

    .auth-body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px;
        background:
            radial-gradient(circle at 14% 16%, rgba(37, 99, 235, 0.18), transparent 28rem),
            linear-gradient(135deg, #f8fbff, #eef5ff);
        overflow: hidden;
    }

    .login-stage {
        width: min(1020px, 100%);
        min-height: 620px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 30px;
    }

    .animation-scene {
        height: 520px;
        position: relative;
    }

    .employee {
        position: absolute;
        left: -90px;
        bottom: 120px;
        width: 180px;
        height: 260px;
        animation: employeeWalk 2.4s ease forwards;
    }

    @keyframes employeeWalk {
        0% { transform: translateX(0); }
        70% { transform: translateX(290px); }
        100% { transform: translateX(290px); }
    }

    .head {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #f3c7a6;
        margin: 0 auto;
        box-shadow: inset 0 -8px 0 rgba(0, 0, 0, 0.06);
    }

    .body-suit {
        width: 94px;
        height: 118px;
        margin: -2px auto 0;
        border-radius: 24px 24px 16px 16px;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
    }

    .leg-left,
    .leg-right {
        position: absolute;
        bottom: 0;
        width: 28px;
        height: 90px;
        border-radius: 14px;
        background: #0f172a;
        transform-origin: top;
    }

    .leg-left { left: 58px; animation: legMove 0.55s linear 4; }
    .leg-right { right: 58px; animation: legMove 0.55s linear 4 reverse; }

    @keyframes legMove {
        0%, 100% { transform: rotate(12deg); }
        50% { transform: rotate(-15deg); }
    }

    .arm {
        position: absolute;
        top: 88px;
        right: 24px;
        width: 24px;
        height: 92px;
        border-radius: 14px;
        background: #1d4ed8;
        transform-origin: top;
        animation: armDrop 3.1s ease forwards;
    }

    @keyframes armDrop {
        0%, 70% { transform: rotate(-18deg); }
        100% { transform: rotate(26deg); }
    }

    .briefcase {
        position: absolute;
        left: 225px;
        bottom: 110px;
        width: 150px;
        height: 92px;
        border-radius: 18px;
        background: linear-gradient(135deg, #6b4226, #3b2415);
        box-shadow: 0 25px 55px rgba(15, 23, 42, 0.2);
        transform: translateY(-55px) scale(0.88);
        opacity: 0;
        animation: caseArrive 3.2s ease forwards;
    }

    .briefcase::before {
        content: "";
        position: absolute;
        width: 58px;
        height: 22px;
        border: 7px solid #3b2415;
        border-bottom: none;
        border-radius: 14px 14px 0 0;
        left: 46px;
        top: -24px;
    }

    .briefcase-lid {
        position: absolute;
        inset: 0;
        border-radius: 18px;
        background: linear-gradient(135deg, #9a673d, #5a331d);
        transform-origin: top;
        animation: caseOpen 4.4s ease forwards;
    }

    @keyframes caseArrive {
        0%, 60% { opacity: 0; transform: translateY(-55px) scale(0.88); }
        80% { opacity: 1; transform: translateY(0) scale(1); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes caseOpen {
        0%, 70% { transform: rotateX(0); }
        100% { transform: rotateX(-68deg); }
    }

    .login-card {
        padding: 34px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: var(--shadow);
        backdrop-filter: blur(22px);
        transform: translateY(22px);
        opacity: 0;
        animation: loginReveal 4.4s ease forwards;
    }

    @keyframes loginReveal {
        0%, 72% { opacity: 0; transform: translateY(22px) scale(0.96); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .popup-particles {
        display: none;
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .auth-body .popup-particles {
        display: block;
    }

    .coin {
        position: absolute;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fde68a, #f59e0b);
        opacity: 0.35;
        animation: floatCoin 8s ease-in-out infinite;
    }

    .coin.one { left: 12%; top: 22%; }
    .coin.two { right: 18%; top: 18%; animation-delay: 1.4s; }
    .coin.three { right: 28%; bottom: 16%; animation-delay: 2.4s; }

    @keyframes floatCoin {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-22px); }
    }

    @media (max-width: 950px) {
        .layout { display: block; }
        .sidebar {
            position: static;
            width: auto;
            margin: 14px;
        }
        .content {
            margin-left: 0;
            width: 100%;
            padding: 18px;
        }
        .hero-grid,
        .grid-2,
        .login-stage {
            grid-template-columns: 1fr;
        }
        .animation-scene {
            display: none;
        }
        .bank-card-3d {
            transform: none;
        }
        table {
            min-width: 760px;
        }
    }


    /* Final compact professional patch */
    .content {
        padding: 22px;
    }

    .topbar {
        padding: 18px 20px;
        margin-bottom: 16px;
    }

    .topbar h1,
    h1 {
        font-size: clamp(28px, 2.5vw, 36px);
    }

    .cards {
        gap: 14px;
        margin: 16px 0;
    }

    .stat-card {
        padding: 18px;
        min-height: 118px;
        display: block;
        color: inherit;
    }

    .clickable-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 18px 45px rgba(37, 99, 235, 0.16);
        border-color: rgba(37, 99, 235, 0.22);
    }

    .stat-card small {
        display: block;
        color: var(--muted);
        margin-top: 6px;
        font-weight: 700;
    }

    .hero-grid {
        grid-template-columns: 1.35fr 0.65fr;
        gap: 16px;
        margin-bottom: 16px;
    }

    .hero-card,
    .bank-card-3d {
        min-height: 170px;
        padding: 22px;
    }

    .panel {
        padding: 16px;
        margin-bottom: 16px;
    }

    table {
        min-width: 980px;
        border-spacing: 0 8px;
    }

    th,
    td {
        padding: 10px 12px;
    }

    .control-grid {
        grid-template-columns: 1fr;
        min-width: 260px;
        gap: 7px;
    }

    .control-card {
        padding: 8px;
        border-radius: 14px;
    }

    .control-card input,
    .control-card select {
        padding: 9px 10px;
        border-radius: 11px;
    }

    .mini {
        padding: 7px 9px;
        font-size: 13px;
    }

    .sidebar {
        width: 264px;
        inset: 14px auto 14px 14px;
    }

    .content {
        margin-left: 294px;
        width: calc(100% - 294px);
    }

    .sidebar a {
        padding: 12px 13px;
        margin-bottom: 6px;
    }

    .settings-preview {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 18px;
        align-items: center;
    }

    .login-stage {
        min-height: 560px;
    }

    .employee {
        animation-duration: 1.45s;
    }

    .briefcase {
        animation-duration: 1.9s;
    }

    .auth-card {
        animation-delay: 2.05s !important;
    }

    @media (max-width: 980px) {
        .content {
            margin-left: 0;
            width: 100%;
        }

        .sidebar {
            width: auto;
        }

        .hero-grid,
        .settings-preview {
            grid-template-columns: 1fr;
        }
    }



    /* Ultra compact account and transaction patch */
    .compact-topbar {
        min-height: auto;
        align-items: center;
    }

    .compact-panel {
        padding: 14px 16px;
    }

    .compact-accounts-table,
    .compact-transactions-table {
        min-width: 1060px;
        border-spacing: 0 6px;
    }

    .compact-accounts-table th,
    .compact-accounts-table td,
    .compact-transactions-table th,
    .compact-transactions-table td {
        padding: 8px 10px;
        vertical-align: middle;
    }

    .compact-accounts-table tbody tr,
    .compact-transactions-table tbody tr {
        min-height: 64px;
    }

    .account-number-form,
    .type-form,
    .action-form {
        flex-wrap: nowrap;
        gap: 6px;
    }

    .account-number-form input {
        width: 132px;
        padding: 8px 10px;
        font-weight: 800;
    }

    .type-form select {
        width: 110px;
        padding: 8px 10px;
    }

    .action-form .mini,
    .account-number-form .mini,
    .type-form .mini {
        padding: 7px 9px;
        font-size: 12px;
        border-radius: 10px;
        white-space: nowrap;
    }

    .name-cell {
        width: 150px;
    }

    .filter-form select {
        width: 180px;
    }

    /* More realistic lightweight 3D login intro */
    .animation-scene {
        perspective: 1200px;
    }

    .floor-shadow {
        position: absolute;
        left: 120px;
        bottom: 92px;
        width: 340px;
        height: 34px;
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(15, 23, 42, 0.16), transparent 70%);
        filter: blur(3px);
    }

    .employee {
        filter: drop-shadow(0 26px 22px rgba(15, 23, 42, 0.18));
        animation: employeeWalk 2.15s cubic-bezier(.18,.84,.28,1) forwards;
    }

    .hair {
        width: 66px;
        height: 30px;
        background: #111827;
        border-radius: 28px 28px 12px 12px;
        margin: 0 auto -18px;
        position: relative;
        z-index: 2;
    }

    .face-dot {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #0f172a;
        top: 25px;
    }

    .face-dot.left { left: 72px; }
    .face-dot.right { right: 72px; }

    .tie {
        width: 18px;
        height: 58px;
        background: linear-gradient(180deg, #ef4444, #991b1b);
        clip-path: polygon(50% 0, 100% 20%, 70% 100%, 30% 100%, 0 20%);
        margin: -108px auto 0;
        position: relative;
        z-index: 3;
    }

    .shoe-left,
    .shoe-right {
        position: absolute;
        bottom: -8px;
        width: 42px;
        height: 17px;
        border-radius: 14px 18px 8px 8px;
        background: #020617;
    }

    .shoe-left { left: 48px; }
    .shoe-right { right: 48px; }

    .briefcase {
        transform-style: preserve-3d;
        animation: caseArrive 2.55s cubic-bezier(.18,.84,.28,1) forwards;
    }

    .briefcase::after {
        content: "";
        position: absolute;
        inset: 40px 14px auto;
        height: 5px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
    }

    .briefcase-lid {
        transform-style: preserve-3d;
        animation: caseOpen 3.25s cubic-bezier(.2,.8,.18,1) forwards;
        box-shadow: inset 0 -10px 18px rgba(0, 0, 0, 0.16);
    }

    .case-glow {
        position: absolute;
        left: 225px;
        bottom: 102px;
        width: 150px;
        height: 72px;
        border-radius: 24px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.34), transparent 70%);
        opacity: 0;
        animation: caseGlow 3.3s ease forwards;
        filter: blur(8px);
    }

    @keyframes caseGlow {
        0%, 70% { opacity: 0; transform: scale(.8); }
        100% { opacity: 1; transform: scale(1.2); }
    }

    .login-card {
        animation: loginReveal 3.35s cubic-bezier(.2,.8,.18,1) forwards;
    }

</style>
<script>
    function confirmAction(message) {
        return confirm(message || 'Are you sure?');
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('input[name="accountNumber"]').forEach(function (input) {
            input.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '').slice(0, 18);
            });
        });
    });
</script>

